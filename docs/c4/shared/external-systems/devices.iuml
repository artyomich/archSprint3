@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

' Пользователь
Person(user, "Пользователь", "Конечный пользователь системы")

' Внешние устройства
System_Ext(smart_device, "Умное устройство", "ESP32/Arduino", "Устройства управления")
System_Ext(rele, "Реле", "Физическое реле", "Переключение электрических цепей")
System_Ext(sensor, "Специальные датчики", "Датчики температуры, движения и т.п.", "Сбор данных окружения")
System_Ext(heater, "Устройство отопления", "Термостат/обогреватель", "Контроль температуры помещения")

' Основная система
Boundary(house_system, "Система Умного Дома") {
  Container(web_app, "WEB-App", "React", "Веб-интерфейс управления умным домом")
  Container(api_gateway, "API-Gateway", "Nginx", "Проксирование трафика")
  Container(house_monitoring, "House monitoring", "Spring Boot", "Отображение текущего состояния системы")
  ContainerDb(house_monitoring_database, "House monitoring database", "Postgres", "Хранение данных мониторинга")
  Container(house_managment, "House management", "Spring Boot", "Управление системой")
  ContainerDb(house_managment_database, "House management database", "Postgres", "Хранение данных управления")
  ContainerQueue(house_event_broker, "Брокер сообщений", "Apache Kafka", "Хранение событий системы")
  Container(command_executor, "Command executor", "Spring Boot", "Выполнение команд на устройствах")
}

' Связи между компонентами
Rel(user, web_app, "Использует через браузер")
Rel(web_app, api_gateway, "Отправляет запросы к API")
Rel(api_gateway, house_monitoring, "Запрашивает данные")
Rel(api_gateway, house_managment, "Передаёт команды")
Rel(house_monitoring, house_monitoring_database, "Чтение данных")
Rel(house_managment, house_managment_database, "Чтение/запись данных")
Rel(house_managment, house_event_broker, "Публикует события")
Rel(house_event_broker, command_executor, "Передаёт команды на исполнение")
Rel(command_executor, smart_device, "Отправляет команды управления")
Rel(smart_device, sensor, "Считывает показания")
Rel(smart_device, rele, "Управляет состоянием")
Rel(smart_device, heater, "Управляет нагревом")
Rel(sensor, house_event_broker, "Публикует данные в поток")