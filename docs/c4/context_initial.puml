@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

skinparam wrapWidth 300
LAYOUT_WITH_LEGEND()
LAYOUT_LANDSCAPE()
title
    <b>Тёплый дом (монолитное приложение)</b>
    <i>Приложение по управлению умным домом (SaaS)</i>
end title

top to bottom direction

Person(user, "User", "Пользователь")
Person(admin, "Administrator", "Администратор системы")
System(SmartHomeApp, "House management (setting and monitoring)", "Приложение по управлению умным домом")

System_Ext(sensor, "Sensor", "Датчики температуры")
System_Ext(remote_control, "Remote control", "Устройство дистанционного управления")

Rel(user, SmartHomeApp, "Управляет системой отопления")
Rel(admin, SmartHomeApp, "Подключает сервис и решает инциденты")
Rel(SmartHomeApp, sensor, "Считывает значения температуры")
Rel(SmartHomeApp, remote_control, "Управляет отоплением (вкл/выкл), управляет температурой")
@enduml